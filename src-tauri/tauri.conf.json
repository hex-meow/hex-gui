{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hexmeow-gui",
  "mainBinaryName": "hex-motor-gui",
  "identifier": "com.hexmecha.hex-motor-gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "hexmeow-gui",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Service GUI for hexmeow motors, robots, and firmware",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": ["hex-motor-gui"],
        "conflicts": ["hex-motor-gui"],
        "replaces": ["hex-motor-gui"],
        "desktopTemplate": "linux/app.desktop",
        "postInstallScript": "linux/deb-postinst.sh"
      },
      "rpm": {
        "desktopTemplate": "linux/app.desktop"
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "58092ba2-2394-5e69-bbb4-5fd81b134dc5"
      },
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
